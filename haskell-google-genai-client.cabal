cabal-version:      3.0
name:               haskell-google-genai-client
version:            0.2.0
synopsis:           Gemini API client (Gemini API and Vertex AI backends)
description:
  Haskell client for Google's Gemini models. Data types and endpoints are
  generated from Google's Discovery document with proto3-aware optionality
  rules; the HTTP runtime is hand-written and logs through Katip.
  Fork of sonowz/haskell-google-genai-client maintained by iconnect.

category:           API
homepage:           https://github.com/iconnect/haskell-google-genai-client#readme
bug-reports:        https://github.com/iconnect/haskell-google-genai-client/issues
author:             SoonHo Seo, iconnect
maintainer:         alfredo@well-typed.com
copyright:          2025 Sonowz, 2026 iconnect
license:            MIT
license-file:       LICENSE
build-type:         Simple
tested-with:        GHC ==9.6.7 || ==9.10.3
extra-source-files:
  README.md
  spec/generativelanguage-v1beta.json
  tests/codegen/mini-discovery.json
  tests/fixtures/*.json

source-repository head
  type:     git
  location: https://github.com/iconnect/haskell-google-genai-client

flag codegen
  description: Build the genai-codegen executable and its tests
  default:     False
  manual:      True

common warnings
  ghc-options:
    -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns
    -Wredundant-constraints -Wunused-packages

library
  import:           warnings
  hs-source-dirs:   lib
  default-language: GHC2021
  exposed-modules:
    GenAI.Client
    GenAI.Client.API
    GenAI.Client.Files
    GenAI.Client.Model
    GenAI.Client.Run
    GenAI.Client.Types
  build-depends:
    , aeson              >=2.1  && <2.3
    , base               >=4.18 && <5
    , base64-bytestring  >=1.2  && <1.3
    , bytestring         >=0.11 && <0.13
    , containers         >=0.6  && <0.8
    , http-client        >=0.7  && <0.8
    , http-types         >=0.12 && <0.13
    , katip              >=0.8  && <0.9
    , scientific         >=0.3  && <0.4
    , text               >=2.0  && <2.2
    , time               >=1.12 && <1.15

executable genai-codegen
  import:           warnings
  hs-source-dirs:   codegen
  main-is:          Main.hs
  default-language: GHC2021
  other-modules:
    Analyse
    Discovery
    Emit

  build-depends:
    , aeson >= 2.2.5 && < 2.3
    , base >= 4.20.2 && < 4.21
    , bytestring >= 0.12.2 && < 0.13
    , directory >= 1.3.8 && < 1.4
    , filepath >= 1.5.4 && < 1.6
    , text >= 2.1.3 && < 2.2

  if !flag(codegen)
    buildable: False
  else
    build-depends:
     containers >= 0.7 && < 0.8

test-suite codegen-tests
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   tests/codegen codegen
  main-is:          Main.hs
  default-language: GHC2021
  other-modules:
    Analyse
    Discovery
    Emit

  build-depends:
    , aeson >= 2.2.5 && < 2.3
    , base >= 4.20.2 && < 4.21
    , bytestring >= 0.12.2 && < 0.13
    , hspec >= 2.11.17 && < 2.12
    , text >= 2.1.3 && < 2.2

  if !flag(codegen)
    buildable: False
  else
    build-depends:
     containers >= 0.7 && < 0.8

test-suite tests
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   tests
  main-is:          Test.hs
  default-language: GHC2021
  other-modules:
    Files
    Fixtures
    Instances
    Live
    Run
    Url
    Wire
  build-depends:
    , aeson
    , base
    , bytestring
    , haskell-google-genai-client
    , hspec
    , http-client
    , http-client-tls
    , katip
      -- Lower bound: a known-good floor for the Arbitrary (Map k v)
      -- instance, which Instances.hs relies on (it emits no such instance
      -- itself).
    , QuickCheck >=2.14.3 && <2.19
    , text
    , time
