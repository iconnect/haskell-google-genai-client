cabal-version:      3.0
name:               haskell-google-genai-client
version:            0.2.0
synopsis:           Gemini API client (Gemini API and Vertex AI backends)
description:
  Haskell client for Google's Gemini models. Data types and endpoints are
  generated from Google's Discovery document with proto3-aware optionality
  rules; the HTTP runtime is hand-written and logs through Katip.
  Fork of sonowz/haskell-google-genai-client maintained by iconnect.

category:           API
homepage:           https://github.com/iconnect/haskell-google-genai-client#readme
bug-reports:        https://github.com/iconnect/haskell-google-genai-client/issues
author:             SoonHo Seo, iconnect
maintainer:         alfredo@well-typed.com
copyright:          2025 Sonowz, 2026 iconnect
license:            MIT
license-file:       LICENSE
build-type:         Simple
tested-with:        GHC ==9.6.7 || ==9.10.3
extra-source-files:
  README.md
  spec/generativelanguage-v1beta.json

source-repository head
  type:     git
  location: https://github.com/iconnect/haskell-google-genai-client

flag codegen
  description: Build the genai-codegen executable and its tests
  default:     False
  manual:      True

common warnings
  ghc-options:
    -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns
    -Wredundant-constraints

library
  import:           warnings
  hs-source-dirs:   lib
  default-language: GHC2021
  exposed-modules:  GenAI.Client.Types
  build-depends:
    , aeson              >=2.1  && <2.3
    , base               >=4.18 && <5
    , base64-bytestring  >=1.2  && <1.3
    , bytestring         >=0.11 && <0.13
    , case-insensitive   >=1.2  && <1.3
    , containers         >=0.6  && <0.8
    , http-client        >=0.7  && <0.8
    , http-client-tls    >=0.3  && <0.4
    , http-types         >=0.12 && <0.13
    , katip              >=0.8  && <0.9
    , scientific         >=0.3  && <0.4
    , text               >=2.0  && <2.2
    , time               >=1.12 && <1.15

executable genai-codegen
  import:           warnings
  hs-source-dirs:   codegen
  main-is:          Main.hs
  default-language: GHC2021
  build-depends:
    , aeson
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , text

  if !flag(codegen)
    buildable: False

test-suite codegen-tests
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   tests/codegen codegen
  main-is:          Main.hs
  default-language: GHC2021
  build-depends:
    , aeson
    , base
    , bytestring
    , containers
    , hspec
    , text

  if !flag(codegen)
    buildable: False

test-suite tests
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   tests
  main-is:          Test.hs
  default-language: GHC2021
  other-modules:    Wire
  build-depends:
    , aeson
    , base
    , bytestring
    , containers
    , haskell-google-genai-client
    , hspec
    , http-client
    , http-client-tls
    , katip
    , QuickCheck
    , text
    , time
